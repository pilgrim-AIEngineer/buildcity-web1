{
  "appId": "com.buildcity.app",
  "appName": "BuildCity",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "backgroundColor": "#0A192F",
      "style": "DARK",
      "overlaysWebView": false
    },
    "CapacitorUpdater": {
      "autoUpdate": true,
      "updateUrl": "https://www.buildcity.in/api/ota-customer",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 10000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true
    }
  }
}
